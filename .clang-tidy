# .clang-tidy
# Tuned after a full compile_commands scan. Noisy or ABI-hostile checks stay
# disabled (trailing-return-type, designated-initializers, enum-size,
# exception-escape, magic-numbers).
#
# Applied and left enabled: modernize-use-nodiscard, modernize-use-auto,
# bugprone-easily-swappable-parameters.
#
# macOS: Homebrew LLVM clang-tidy needs the Apple SDK, because compile_commands
# is generated by /usr/bin/c++ without an explicit -isysroot:
#   run-clang-tidy -p build/dev-metal \
#     -extra-arg="-isysroot$(xcrun --show-sdk-path)" \
#     -extra-arg="-stdlib=libc++" -j 8
Checks: >
  -*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-designated-initializers,
  bugprone-*,
  -bugprone-exception-escape,
  performance-*,
  -performance-enum-size,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  misc-*,
  -misc-non-private-member-variables-in-classes

WarningsAsErrors: ''
HeaderFilterRegex: '.*/vg-api/(src|include|tests|tools)/.*'
FormatStyle: file
CheckOptions:
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
